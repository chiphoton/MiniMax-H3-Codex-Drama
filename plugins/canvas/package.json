{
  "name": "codex-drama-canvas",
  "version": "0.2.0",
  "private": true,
  "description": "Local workflow canvas and Codex Plan adviser for Codex Drama",
  "type": "module",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
