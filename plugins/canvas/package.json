  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
